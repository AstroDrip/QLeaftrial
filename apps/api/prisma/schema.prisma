generator client {
  provider = "prisma-client-js"
  output   = "../generated/sqlite"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum PaymentMethod {
  COD
  PAYMENT_LINK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model StoreSettings {
  id                      String   @id
  orderingEnabled         Boolean  @default(true)
  commercialRegistration String?
  ecommerceLicense       String?
  businessAddress        String?
  supportEmail           String?
  supportPhone           String?
  deliveryFeeQar         Int? // unused: delivery is no longer priced; kept so no data migration is needed
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Session {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String         @id @default(cuid())
  slug        String         @unique
  sku         String         @unique
  name        String
  nameAr      String?
  description String
  descriptionAr String?
  category    String
  categoryAr  String?
  light       String?
  lightAr     String?
  priceQar    Int
  // The price before a genuine reduction; shown struck through only when it is higher than priceQar.
  compareAtPriceQar Int?
  costPrice   Int
  published   Boolean        @default(false)
  // Chosen in admin for the home page's Featured section.
  featured    Boolean        @default(false)
  scientificName String?
  watering    String?
  wateringAr  String?
  // "easy" | "moderate" | "demanding"
  careLevel   String?
  // "indoor" | "outdoor" | "indoor-outdoor"
  placement   String?
  // Admin-only: an identification or detail the shop still has to confirm before publishing.
  needsReview Boolean        @default(false)
  reviewNote  String?
  // Extra words customers may search with (other spellings, local names), comma or line separated.
  searchAliases String?
  media       ProductMedia[]
  inventory   Inventory?
  orderItems  OrderItem[]
  reviews     Review[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([published, category])
  @@index([published, priceQar])
  @@index([published, name])
  @@index([published, featured])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  sortOrder Int
  width     Int?
  height    Int?
  purpose   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sortOrder])
}

model Inventory {
  productId String   @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  // Sent by the storefront with each checkout attempt: a retry with the same key returns the order
  // already created instead of creating a second one.
  idempotencyKey  String?       @unique
  customerName    String
  phone           String
  email           String
  addressLine1    String
  area            String
  deliveryNotes   String?
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  paymentUrl      String?
  editSummary     String?
  status          OrderStatus   @default(PENDING)
  subtotalQar     Int
  deliveryFeeQar  Int           @default(0)
  // Below the free-delivery threshold the team confirms the delivery charge with the customer. True until an
  // admin enters it (deliveryFeeQar, possibly 0); deliveryFeeConfirmedAt records when.
  deliveryChargePending  Boolean   @default(false)
  deliveryFeeConfirmedAt DateTime?
  // Google Sheets mirror: when this order's row was last written, or why the last attempt failed (a code only).
  sheetSyncedAt  DateTime?
  sheetSyncError String?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName  String
  sku          String
  unitPriceQar Int
  quantity     Int
  createdAt    DateTime @default(now())
}

// A customer's story shown in the homepage carousel. Only published rows are public; the shop manages
// them from admin. The product link is optional and simply clears if that product is ever deleted.
model Review {
  id           String    @id @default(cuid())
  customerName String
  body         String
  rating       Int
  imageUrl     String?
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  location     String?
  label        String?
  sortOrder    Int       @default(0)
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([published, sortOrder])
  @@index([productId])
}

model RateLimitBucket {
  limiter   String
  keyHash   String
  attempts  Int
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@id([limiter, keyHash])
  @@index([expiresAt])
}
