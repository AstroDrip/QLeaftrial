{
  "name": "qleaves",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "npm run prisma:generate -w @qleaves/api && npm run prisma:migrate -w @qleaves/api && npm run prisma:seed -w @qleaves/api",
    "dev": "concurrently \"npm run dev -w @qleaves/api\" \"npm run dev -w @qleaves/web\"",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
