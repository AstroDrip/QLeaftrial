# Local development defaults
PORT=3000
QLEAVES_DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# Vercel / Supabase production placeholders (set these in Vercel, not in Git)
# Set both variables for every Vercel environment that runs the API.
# QLEAVES_DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres"
# Generate a unique random value containing at least 32 characters. Server-only:
# never prefix this or any database/service credential with VITE_.
# RATE_LIMIT_SALT="replace-with-at-least-32-random-characters"
# SUPABASE_URL="https://PROJECT_REF.supabase.co"
# SUPABASE_SECRET_KEY="sb_secret_replace-me"
# SUPABASE_PRODUCT_IMAGE_BUCKET="product-images"
# Legacy fallback only if your project still uses JWT API keys:
# SUPABASE_SERVICE_ROLE_KEY="replace-me"

# Optional: mirror every order into a private Google Sheet (see docs/deployment/vercel-supabase.md).
# Server-only. Leave all three unset and the shop works exactly as before.
# GOOGLE_SHEETS_ID="id-from-the-sheet-url"
# GOOGLE_SERVICE_ACCOUNT_EMAIL="orders@your-project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEETS_TAB="Orders"

# Administrative seed only: set temporarily in the trusted shell that runs
# `npm run supabase:seed`, then remove it. Do not expose it as a VITE_* variable.
# QLEAVES_ADMIN_SEED_PASSWORD="replace-with-a-strong-unique-password"
